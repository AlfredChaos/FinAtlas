# FinAtlas Backend Environment Variables
# Copy this file to .env and fill in the values

# 应用基础配置
APP_NAME=FinAtlas
DEBUG=false

# 数据库（PostgreSQL + asyncpg）
DATABASE_URL=postgresql+asyncpg://finatlas:finatlas@localhost:5432/finatlas

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Cloudflare R2 对象存储
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finatlas
R2_PUBLIC_URL=

# JWT 认证
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 管理员默认账号
ADMIN_USERNAME=admin
# 使用 python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt'], deprecated='auto').hash('123456'))" 生成
ADMIN_PASSWORD_HASH=

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM / AI Provider（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
